# Vercel Container Runtime entrypoint for bolt.diy.
# Keep the existing Dockerfile and docker-compose.yaml unchanged for local use.

FROM node:22.23.5-bookworm-slim AS build
WORKDIR /app

ENV HUSKY=0
ENV CI=true
ENV CLOUDFLARE_CF_FETCH_ENABLED=false
ENV WRANGLER_SEND_METRICS=false

# workerd/Miniflare needs the system CA bundle for outbound TLS.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
  && update-ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml* ./
RUN pnpm fetch

COPY . .
RUN pnpm install --offline --frozen-lockfile
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm run build

# The existing Vite config uses the Cloudflare preview adapter for SSR.
# Keep its build dependencies in the runtime image because vite preview
# loads vite.config.ts and its plugins when the container starts.
FROM build AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=5173
ENV RUNNING_IN_DOCKER=true
ENV CLOUDFLARE_CF_FETCH_ENABLED=false
ENV WRANGLER_SEND_METRICS=false

EXPOSE 5173

# Vercel routes requests to the port in PORT. The default keeps local
# container runs compatible; Vercel can override PORT at runtime.
CMD ["sh", "-c", "pnpm exec vite preview --host 0.0.0.0 --port ${PORT:-5173} --strictPort"]
